{
  "name": "webrtc_server",
  "version": "1.0.0",
  "description": "webrtc_server",
  "main": "src/index.mjs",
  "scripts": {
    "test": "env-cmd -f .env.local jest --coverage --forceExit --watchAll --maxWorkers=1",
    "updateDb": "npx prisma db push",
    "migrate": "npx prisma migrate dev --name migrate",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"env-cmd -f .env.local nodemon -q dist/index.js .env.local\"",
    "deploy": "concurrently \"npx tsc\" \"npx prisma db push\" \"npm run start\""
  },
